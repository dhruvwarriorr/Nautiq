# Local development only. Change these for any shared deployment.
POSTGRES_USER=nautiq
POSTGRES_PASSWORD=nautiq_local_dev
POSTGRES_DB=nautiq
MINIO_ROOT_USER=nautiq_local
MINIO_ROOT_PASSWORD=nautiq_local_storage
WEB_PORT=3000
API_PORT=8080

# Stable observation scope for the first Argo slice (UTC).
ARGO_OBSERVED_SINCE=2025-10-01T00:00:00Z

# Explicit native model release; leave empty until a verified local release is selected.
ML_RELEASE_ID=
MLFLOW_PORT=5001
UNCERTAINTY_RELEASE_ID=
ANOMALY_RELEASE_ID=

# Exact origin for product sign-in and CSRF checks. HTTPS required except loopback.
PRODUCT_WEB_ORIGIN=http://localhost:3000

# Optional natural-language question parsing. Empty means the built-in deterministic grammar is used and no
# question text leaves this machine. When a key is set, the question text (never saved) is sent to the
# provider to be labelled into a closed-vocabulary frame; Nautiq rebuilds and validates every query itself.
NAUTIQ_LLM_API_KEY=
NAUTIQ_LLM_MODEL=
NAUTIQ_LLM_BASE_URL=
# anthropic or openai (chat completions, e.g. Groq). Empty = auto: a versioned path such as /openai/v1 means openai.
NAUTIQ_LLM_API_FORMAT=
NAUTIQ_LLM_RATE_PER_MINUTE=20

# Copernicus Marine (CMEMS) login, free at https://data.marine.copernicus.eu/register.
# Needed for wave, current and sea-temperature forecasts. Keep real values in .env only.
CMEMS_USERNAME=
CMEMS_PASSWORD=
