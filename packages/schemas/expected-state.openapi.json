                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "rows",
          "profiles",
          "mae",
          "rmse",
          "median_absolute_error",
          "bias",
