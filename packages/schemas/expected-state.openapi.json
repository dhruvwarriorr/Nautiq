          },
          "code": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "request_id"
        ],
        "additionalProperties": false
      },
      "Period": {
        "type": "object",
        "properties": {
          "start_year": {
            "type": "integer"
          },
          "end_year": {
            "type": "integer"
          }
        },
        "required": [
          "start_year",
          "end_year"
        ],
        "additionalProperties": false
      },
      "Metric": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "integer",
            "minimum": 0
          },
          "profiles": {
            "type": "integer",
            "minimum": 0
          },
          "mae": {
            "anyOf": [
              {
                "type": "number"
              },
              {
