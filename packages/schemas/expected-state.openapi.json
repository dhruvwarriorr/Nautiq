            "pattern": "^[a-f0-9]{64}$"
          },
          "snapshot_id": {
            "type": "string",
            "format": "uuid"
          },
          "snapshot_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "parquet_key": {
            "type": "string"
          }
        }
      },
      "Input": {
        "type": "object",
        "required": [
          "profile_id",
          "revision_sha256",
          "raw_sha256"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "raw_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "Problem": {
