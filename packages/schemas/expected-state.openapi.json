          "evaluation_time",
          "code_sha256",
          "environment",
          "calculation_id",
          "calculation_sha256"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "kind": {
            "enum": [
              "normalization",
              "profile_summary",
              "training_snapshot",
              "climatology_fit",
              "climatology_comparison",
              "expected_state_fit",
              "expected_state_comparison"
            ]
          },
          "method_version": {
            "type": "string"
          },
          "inputs": {
