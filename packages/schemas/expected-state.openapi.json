{
  "openapi": "3.1.0",
  "info": {
    "title": "Nautiuq expected mean model evidence API",
    "version": "1.0.0",
    "description": "Explicit pinned native models. Diagnostic residual candidates; promotion can retain climatology. No calibrated intervals, causal explanations or scientific production approval."
  },
  "paths": {
    "/api/v1/expected-state-releases": {
      "get": {
        "summary": "ModelPage",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Immutable model evidence or revision-matched comparison",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelPage"
                }
              }
            }
          },
          "400": {
            "description": "Bounded structured evidence error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Bounded structured evidence error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Bounded structured evidence error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Bounded structured evidence error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
