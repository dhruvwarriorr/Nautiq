{
  "openapi": "3.1.0",
  "info": {
    "title": "Nautiq regional field evidence",
    "version": "1.0.0",
    "description": "One explicit immutable release per request. No mixed cycles, nearest-water substitution or safety verdict. Daily analysis is held only in its full UTC day. Forecasts interpolate native components/strict masks in space and valid time. Stale retained values stay labeled stale. Missing values are null. Route extrema include retained stale samples and do not guarantee unsampled extremes. Polygon means use available native centers and cosine latitude weights; dateline polygons must be split. Request 32 KiB, query 4 KiB, RPC 1 MiB, response 900 KiB, tile 300 KiB, timeout 6 seconds. Limits never silently coarsen routes."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
