            }
          }
        ],
        "responses": {
          "200": {
            "description": "256x256 RGBA Web Mercator native-nearest raster; masks/outside domain transparent. Fixed legend is in variable metadata. X-Field-* headers pin release/checksum/cycle/valid-time/freshness.",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid coordinate, variable or horizon"
          },
          "503": {
            "description": "Runtime or verified chunks unavailable"
          }
        }
      }
