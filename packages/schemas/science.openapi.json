    "/api/v1/training-snapshots/{id}": {
      "get": {
        "summary": "Pinned snapshot policy, inputs, splits and hashes",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Evidence available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "400": {
            "description": "Unknown, repeated, malformed or over-budget query",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Evidence not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Bounded query/download capacity reached",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Evidence unavailable or integrity failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/training-snapshots/{id}/parquet": {
      "get": {
        "summary": "Verified immutable Parquet download",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Evidence available",
            "content": {
              "application/vnd.apache.parquet": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            },
            "headers": {
              "X-Parquet-SHA256": {
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "description": "Verified exact download digest"
              }
            }
          },
          "400": {
            "description": "Unknown, repeated, malformed or over-budget query",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Evidence not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Bounded query/download capacity reached",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Evidence unavailable or integrity failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "request_id"
        ],
        "additionalProperties": false
      },
      "Input": {
        "type": "object",
        "required": [
          "profile_id",
          "revision_sha256",
          "raw_sha256"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "raw_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "Manifest": {
        "type": "object",
        "required": [
          "schema_version",
          "kind",
          "method_version",
          "inputs",
          "output",
          "policy",
          "evaluation_time",
          "code_sha256",
          "environment",
          "calculation_id",
          "calculation_sha256"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "kind": {
            "enum": [
              "normalization",
              "profile_summary",
              "training_snapshot",
              "climatology_fit",
              "climatology_comparison",
              "expected_state_fit",
              "expected_state_comparison",
              "uncertainty_fit",
              "uncertainty_comparison",
              "uncertainty_monitor"
            ]
          },
          "method_version": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Input"
            }
          },
          "output": {
            "type": "object"
          },
          "policy": {
            "type": "object"
          },
          "evaluation_time": {
            "type": "string",
            "format": "date-time"
          },
          "code_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "environment": {
            "type": "object"
          },
          "calculation_id": {
            "type": "string",
            "format": "uuid"
          },
          "calculation_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "snapshot_id": {
            "type": "string",
            "format": "uuid"
          },
          "snapshot_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "parquet_key": {
            "type": "string"
          }
        }
      },
      "SourceHealth": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": 1
          },
          "source_freshness": {
            "enum": [
              "unverified",
              "unknown",
              "fresh",
              "stale",
              "invalid_clock"
            ]
          },
          "ingestion_state": {
            "enum": [
              "unknown",
              "on_schedule",
              "stale",
              "degraded",
              "invalid_clock"
            ]
          },
          "coverage_state": {
            "type": "string"
          },
          "expected_update_hours": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "cadence_verified": {
            "type": "boolean"
          },
          "freshness_budget_hours": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "ingestion_budget_hours": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "last_successful_fetch": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "last_fetch_age_hours": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "newest_observed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "observation_age_hours": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "latest_run_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "last_failure_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "pending_event_count": {
            "type": "integer",
            "minimum": 0
          },
          "oldest_pending_age_hours": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "qc_rejection_count": {
            "type": "integer",
            "minimum": 0
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "schema_version",
          "source_freshness",
          "ingestion_state",
          "coverage_state",
          "expected_update_hours",
          "cadence_verified",
          "freshness_budget_hours",
          "ingestion_budget_hours",
          "last_successful_fetch",
          "last_fetch_age_hours",
          "newest_observed_at",
          "observation_age_hours",
          "latest_run_status",
          "last_failure_code",
          "pending_event_count",
          "oldest_pending_age_hours",
          "qc_rejection_count",
          "checked_at"
        ],
        "additionalProperties": false
      },
      "Source": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "monitor_checked_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "monitor_state": {
            "enum": [
              "current",
              "unavailable"
            ]
          },
          "health": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceHealth"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "source_id",
          "metadata",
          "monitor_checked_at",
          "monitor_state",
          "health"
        ],
        "additionalProperties": false
      },
      "SourcePage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            }
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "Rejection": {
        "type": "object",
        "properties": {
          "rejection_id": {
            "type": "string",
            "format": "uuid"
          },
          "artifact_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_id": {
            "type": "string"
          },
          "profile_index": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "variable": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "rule_id": {
            "type": "string"
          },
          "reason_code": {
            "type": "string"
          },
          "qc_version": {
            "type": "string"
          },
          "normalizer_version": {
            "type": "string"
          },
          "rejected_count": {
            "type": "integer",
            "minimum": 1
          },
          "context": {
            "type": "object"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "rejection_id",
          "artifact_id",
          "source_id",
          "profile_index",
          "variable",
          "rule_id",
          "reason_code",
          "qc_version",
          "normalizer_version",
          "rejected_count",
          "context",
          "created_at"
        ],
        "additionalProperties": false
      },
      "RejectionPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Rejection"
            }
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "Revision": {
        "type": "object",
        "properties": {
          "revision_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "data_mode": {
            "enum": [
              "R",
              "A",
              "D"
            ]
          },
          "source_updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "selected_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "superseded_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "science_ready": {
            "type": "boolean"
          },
          "calculation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
