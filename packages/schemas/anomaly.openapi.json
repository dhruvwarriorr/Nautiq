          "fallback": {
            "type": "boolean"
          },
          "profiles": {
            "type": "integer",
            "minimum": 0
          },
          "resolution_percent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "required": [
          "requested_group",
          "group",
          "fallback",
          "profiles",
          "resolution_percent",
          "reason",
          "values"
        ]
      },
      "VariableEvidence": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "diagnostic",
              "scores_only",
              "unavailable"
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "complete": {
            "type": "boolean"
          },
          "qualified": {
            "const": false
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnomalyPoint"
            },
            "minItems": 11,
            "maxItems": 11
          },
          "score_evidence": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScoreEvidence"
              },
              {
                "type": "null"
              }
            ]
          },
          "percentiles": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PercentileEvidence"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "status",
          "reason",
          "complete",
          "qualified",
          "points",
          "score_evidence",
          "percentiles"
        ]
      },
      "AnomalyResult": {
        "type": "object",
        "properties": {
          "method_version": {
            "const": "weighted-residual-profile-v1"
          },
          "status": {
            "enum": [
              "diagnostic",
              "partial",
              "unavailable"
            ]
          },
          "supported_variables": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "depths_m": {
            "const": [
              10,
              20,
              30,
              50,
              75,
              100,
              150,
              200,
              300,
              400,
              500
            ]
          },
          "coverage_policy": {
            "const": "complete_10_500m_per_variable"
          },
          "scale_estimator": {
            "const": "train_fitted_rearranged_quantile_half_interdecile_width"
          },
          "release_approved": {
            "const": false
          },
          "variables": {
            "type": "object",
            "properties": {
              "temperature_c": {
                "$ref": "#/components/schemas/VariableEvidence"
              },
              "practical_salinity": {
                "$ref": "#/components/schemas/VariableEvidence"
              }
            },
            "required": [
              "temperature_c",
              "practical_salinity"
            ]
          }
        },
        "required": [
          "method_version",
          "status",
          "supported_variables",
          "depths_m",
          "coverage_policy",
          "scale_estimator",
          "release_approved",
          "variables"
        ]
      },
