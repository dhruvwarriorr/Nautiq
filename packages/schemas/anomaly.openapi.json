{
  "openapi": "3.1.0",
  "info": {
    "title": "Nautiq profile anomaly diagnostics",
    "version": "1.0.0",
    "description": "Fixed complete 10\u2013500m, uncertainty-normalized residual magnitude, Ledoit\u2013Wolf correlation distance and weighted discrete FPCA. Separate empirical historical ranks and comparison-only Z-score/Isolation Forest baselines. Exact uncertainty/mean/reference pins. No scientifically qualified anomaly verdict."
  },
  "paths": {
    "/api/v1/anomaly-releases": {
      "get": {
        "summary": "AnomalyPage",
        "responses": {
          "200": {
            "description": "Hash-pinned frozen evidence or current revision-matched evidence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnomalyPage"
                }
              }
            }
          },
          "400": {
            "description": "Bounded structured evidence error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Bounded structured evidence error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Bounded structured evidence error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Bounded structured evidence error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          }
        ]
      }
    },
