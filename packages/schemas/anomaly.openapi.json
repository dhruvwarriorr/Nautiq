  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "request_id"
        ],
        "additionalProperties": false
      },
      "AnomalyPoint": {
        "type": "object",
        "properties": {
          "depth_m": {
            "type": "number"
          },
          "observed": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "expected_mean": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "residual": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "scale": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "scale_floored": {
            "type": "boolean"
          },
          "standardized_residual": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "covered": {
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "training_center": {
            "type": "number"
          },
          "centered_standardized_residual": {
            "type": "number"
          },
          "weighted_contribution": {
            "type": "number"
          },
          "mahalanobis_contribution": {
            "type": "number"
          },
          "reconstructed_standardized_residual": {
            "type": "number"
          },
          "reconstruction_error": {
            "type": "number"
          }
        },
        "required": [
          "depth_m",
          "observed",
          "expected_mean",
          "residual",
          "scale",
          "scale_floored",
          "standardized_residual",
          "covered",
          "reason"
        ]
      },
      "ScoreEvidence": {
        "type": "object",
        "properties": {
          "scores": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "component_scores": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "component_distance_contributions": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "dominant_component": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        },
        "required": [
          "scores",
          "component_scores",
          "component_distance_contributions",
          "dominant_component"
        ]
      },
      "PercentileEvidence": {
        "type": "object",
