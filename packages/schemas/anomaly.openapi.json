          "release_id",
          "uncertainty_id",
          "expected_id",
          "reference_id",
          "snapshot_id",
          "calculation_id",
          "created_at",
          "status",
          "selected",
          "release_approved",
          "supported_variables",
          "depths_m",
          "coverage_policy",
          "scale_estimator"
        ]
      },
      "AnomalySelection": {
