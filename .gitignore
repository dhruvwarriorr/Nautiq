.DS_Store
.env
.venv/
.tools/
node_modules/
.next/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
*.tsbuildinfo
artifacts/

# Test files and fixtures
**/tests/
**/*_test.go
**/*_test.py
**/test_*.py
**/*.test.*
**/*.spec.*

# Private deployment secrets, certificates and encrypted backup artifacts
secrets/
backups/
.env.production
*.key
*.pem

# Operator outputs retain no place in source or image contexts.
**/*.backup
**/*_database_url
**/database_password
**/storage_*_user
**/storage_*_password
**/smtp_username
**/smtp_password
**/tls_cert
**/tls_key
